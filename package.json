{
  "name": "vadhyar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NovaDesk learning fixture with a disclosed seeded ownership bug",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabari-nath17/vadhyar.git"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "vscode": "^1.140.0"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint src scripts novadesk/src tests fixtures vitest.config.ts eslint.config.mjs --max-warnings=0",
    "test": "vitest run --reporter=verbose",
    "build": "node scripts/build.mjs",
    "test:host": "node scripts/test-host.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.140.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "displayName": "Vadhyar",
  "publisher": "sabari-nath17",
  "main": "./dist/extension.cjs",
  "categories": [
    "Education"
  ],
  "activationEvents": [
    "onCommand:vadhyar.open"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Runs only in a trusted prepared NovaDesk workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "vadhyar.open",
        "title": "Vadhyar: Understand this change"
      },
      {
        "command": "vadhyar.setupKey",
        "title": "Vadhyar: Set OpenAI API key securely"
      }
    ],
    "configuration": {
      "title": "Vadhyar",
      "properties": {
        "vadhyar.model": {
          "type": "string",
          "default": "gpt-6-astra",
          "scope": "application",
          "description": "OpenAI model for Explain. No automatic fallback; account access must be verified."
        }
      }
    }
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "openai": "7.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
